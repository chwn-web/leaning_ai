{
  "name": "dsh-session-anywhere",
  "version": "0.1.0",
  "description": "Per-session cloud sync for DeepSeek Harness: flip one switch on the composer to push a single conversation into your own private git repo, or keep it strictly local.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "sync",
    "backup",
    "git"
  ],
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "engine/sync.py",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chwn-web/leaning_ai"
  },
  "homepage": "https://github.com/chwn-web/leaning_ai/tree/main/plugins/session-cloud",
  "icon": "./icon.svg"
}
